# Copy to apps/web/.env.local (web) and apps/ai/.env (AI service). Never commit real values.
# `pnpm db:start` prints local Supabase URL and keys.

# ---------- web ----------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never NEXT_PUBLIC_
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=                # shown on /privacy and /terms; leave empty until there is one
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Email over SMTP. Dev: Gmail (smtp.gmail.com, 465, your Gmail + app password). Launch: Resend (smtp.resend.com, 465, user "resend", API key).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
CRON_SECRET=                        # any long random string; Vercel Cron sends it as a Bearer token
PUSH_WEBHOOK_SECRET=                # any long random string; also set as push_secret in app_private.config
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_HMAC_SECRET=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---------- ai service ----------
DATABASE_URL=                       # Supabase pooled connection (service)
SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY (shared with web, above)
LLM_PROVIDER=anthropic              # anthropic | openai
LLM_API_KEY=
EMBEDDING_MODEL=
# AI_SERVICE_HMAC_SECRET (shared with web, above)
JUDGE0_URL=                         # phase 7, optional
